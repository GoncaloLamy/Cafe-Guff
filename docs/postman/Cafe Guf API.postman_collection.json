      "item": [
        {
          "name": "GET menu - 200 array with name price allergies",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Response body is an array whose items have name, price, allergies', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json).to.be.an('array');",
                  "    json.forEach(function(item) {",
                  "        pm.expect(item).to.have.property('name');",
                  "        pm.expect(item).to.have.property('price');",
                  "        pm.expect(item).to.have.property('allergies');",
                  "    });",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
