  "item": [
    {
      "name": "Story 7, weather",
      "item": [
        {
          "name": "GET weather default location - 200 current and 7 day forecast",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Response has current weather and a 7 day forecast', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.current.temperature).to.be.a('number');",
                  "    pm.expect(json.windspeed).to.be.a('number');",
                  "    pm.expect(json.humidity).to.be.a('number');",
                  "    pm.expect(json.winddirection).to.be.a('string');",
                  "    pm.expect(json.week).to.have.length(7);",
                  "    pm.expect(json.week[0]).to.have.all.keys('date', 'temperatureMin', 'temperatureMax', 'condition');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/weather",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "weather"
              ],
              "query": []
            }
          },
          "response": []
        },
